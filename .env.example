# Docker Compose chạy được ngay với giá trị mặc định; chỉ copy file này thành .env khi cần tuỳ biến.

# ── Cổng ───────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8000
# Mặc định chỉ nghe loopback; deploy LAN/server thì đổi thành 0.0.0.0.
BIND_ADDRESS=127.0.0.1

# ── Khởi động nhanh cục bộ ─────────────────────────────
SAG_ENVIRONMENT=dev
SAG_CORS_ORIGINS=http://localhost:3000
# Tắt đăng ký bằng email; luồng tạo danh tính cục bộ không bị ảnh hưởng.
SAG_ALLOW_REGISTRATION=false
# Ngôn ngữ PROMPT trích xuất của engine: 'en' | 'vi' (không phải ngôn ngữ giao diện).
SAG_SAG_LANGUAGE=en

# Production bắt buộc đặt giá trị ngẫu nhiên mạnh: openssl rand -hex 32
# Dev cục bộ để trống thì Compose dùng khoá chỉ hợp lệ trên máy này.
SAG_SECRET_KEY=

# Địa chỉ backend mà trình duyệt gọi (nội tuyến lúc build; đổi thì phải build lại image web).
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Web bật zoom trong trang; bản desktop build thì đặt false.
NEXT_PUBLIC_ENABLE_WINDOW_SCALING=true

# ── LLM / Embedding (cũng có thể điền trong Settings sau khi chạy) ──
# KHÔNG có gateway bên thứ ba nào cấu hình sẵn. Để trống Base URL = dùng
# endpoint chính chủ của provider.
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=
SAG_LLM_API_KEY=
SAG_LLM_MODEL=
SAG_LLM_MAX_TOKENS=20000
# Dùng Anthropic / Gemini native thì đổi SAG_LLM_PROVIDER tương ứng, để trống Base URL.
SAG_EMBEDDING_MODEL=bge-m3
SAG_EMBEDDING_BASE_URL=
SAG_EMBEDDING_API_KEY=

# ── Bóc tách tài liệu: MarkItDown chạy cục bộ, không gọi dịch vụ ngoài ──
SAG_DOCUMENT_PARSER=markitdown

# ── Postgres cho production (compose.postgres.yaml) ────
POSTGRES_USER=sag
# Bắt buộc khi dùng bản production; gợi ý: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=sag

# ── Độ ổn định (tuỳ chọn, bỏ comment để bật) ───────────
# SAG_JOB_MAX_ATTEMPTS=3
# SAG_ENGINE_CACHE_SIZE=16
# SAG_ENGINE_WARMUP_COUNT=4
